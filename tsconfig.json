{
  "compilerOptions": {
    "target": "ES2020", // ✔ ใช้ ES2020 ขึ้นไปดีที่สุดกับ ESM
    "module": "ESNext", // ✔ ใช้ ESM
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true, // ✔ ป้องกันปัญหา extension เวลา import .ts
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": ["node", "estree"],

    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "app/components/TeacherMidtermCalendar.tsx",
    "app/components/DetailPanel.js"
  ],
  "exclude": ["node_modules"]
}
